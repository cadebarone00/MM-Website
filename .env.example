# Supabase project settings — see docs/supabase-setup.md for where to find these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scorecard photo/PDF import in Admin Center. Keep this server-only key out
# of NEXT_PUBLIC_ variables. Optional: CSV/Excel scorecard imports work
# locally without it; photos and PDFs require it.
OPENAI_API_KEY=
# Optional cost/quality override for scorecard image recognition.
OPENAI_SCORECARD_MODEL=gpt-5.6-luna

# Shared secret with appscript/write-scores.gs — see appscript/README.md
LIVE_FEED_URL=
SCOREKEEPER_SERVER_SECRET=

# Shared secret with MM-Scorekeeper's Python backend (maroon-masters-python-api) — see docs/superpowers/plans/2026-08-27-scorekeeper-portal-merge-phase1-foundation.md
PYTHON_API_URL=
PYTHON_API_SECRET=

# Public — safe to expose to the browser. Same Supabase project/anon key
# the server already uses (SUPABASE_URL/SUPABASE_ANON_KEY above), just
# re-exposed under the NEXT_PUBLIC_ prefix Next.js requires to bundle a
# value into client code. Used by lib/supabase/client.ts (Task 9) for the
# scoring screen's live-update subscriptions. Every table it subscribes to
# has a public-read RLS policy and no write policy at all, so this key
# cannot write anything from the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
## Public YouTube video ID for the scheduled/live broadcast. Leave blank until coverage is ready.
NEXT_PUBLIC_YOUTUBE_LIVE_VIDEO_ID=

# Cloudflare R2 — shot video storage for the Admin Center "Scorecards &
# Video" screen (everything else stays on Supabase). R2 charges nothing to
# serve a file back out, unlike Supabase Storage's bandwidth pricing.
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from an R2
# API Token (Cloudflare dashboard → R2 → Manage R2 API Tokens). R2_PUBLIC_URL
# is the bucket's public r2.dev URL (R2 → your bucket → Settings → Public
# Access), no trailing slash — e.g. https://pub-xxxxxxxx.r2.dev. That r2.dev
# URL is meant for testing, not guaranteed production traffic levels; a
# custom domain is the production-grade option if this ever needs it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shot-videos
R2_PUBLIC_URL=

# LOCAL DEV ONLY: set to true to open the /play design demo at /dev/play
# (fixture data, no login or Supabase). It only works under `npm run dev`;
# production builds always return 404 for /dev/play, whatever this says.
# DEV_PLAY_DEMO=true

# Golf Trip integrations (FUTURE — none are connected yet; leave blank).
# Server-only: never add a NEXT_PUBLIC_ prefix. Read only by
# lib/platform/tripIntegrationsServer.ts; a provider switches from
# "planned" to "configured" once all of its keys are set.
# FLIGHT_DATA_API_KEY=
# TEE_TIME_API_KEY=
# YELP_API_KEY=

# Golf Trip destination search (Google Places API (New)). Server-only: read only by
# lib/platform/location/locationService.ts, never sent to the browser.
# Google Cloud → APIs & Services → enable "Places API (New)" (billing on), then
# Credentials → create an API key restricted to Places API (New), and set a daily
# quota cap as a cost guard. Blank = the Destination box stays plain text.
GOOGLE_PLACES_API_KEY=

# Golf Trip weather (National Weather Service, free, no key). NWS asks every app to say
# who it is: put a website or email they can reach you at. Server-only, read only by
# lib/platform/weather/weatherService.ts. Blank still works (sent as "The Maroon App").
NWS_CONTACT=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
