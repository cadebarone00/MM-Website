{
  "expo": {
    "name": "Balata",
    "slug": "the-maroon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.themaroon.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "site.themaroon.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Balata uses your photos so you can pick a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#500001"
        }
      ]
    ],
    "scheme": "themaroon",
    "backgroundColor": "#fbf8f1",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1cf4de0e-7bb9-4887-9b2e-e0e58f24b288"
      }
    },
    "owner": "cadebarone00"
  }
}
